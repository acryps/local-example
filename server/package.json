{
	"scripts": {
		"build": "esbuild index.ts --bundle --outfile=.built/index.js --platform=node --external:@acryps/local --external:pg-native --external:express --target=es2018 && acryps-local compile",
		"start": "npm run build && TZ=UTC environment node .built/index.js",
		"database:update": "environment acryps-local create-context"
	},
	"environment": {
		"pghost": "Database Host",
		"pgdatabase": "Database Database",
		"pguser": "Database User",
		"pgpassword": "Database Password"
	},
	"dependencies": {
		"@acryps/local": "file:../../local",
		"express": "^5.1.0"
	},
	"devDependencies": {
		"@acryps/environment": "^2.8.0",
		"@types/node": "^18.11.15",
		"esbuild": "^0.20.1",
		"typescript": "^5.2.2"
	}
}
